# Host port for the Postgres container (change if 5432 is already in use;
# keep DATABASE_URL in sync)
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trainer:trainer@localhost:5432/trainer
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash   # DeepSeek V4.1 Flash on OpenRouter
LLM_PROVIDERS=together,deepinfra/fp8     # preferred OpenRouter providers (latency + prompt cache)
MODEL_SERVER_URL=http://localhost:8001
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
PHONEME_MODEL=facebook/wav2vec2-xlsr-53-espeak-cv-ft
TTS_VOICE=af_heart         # American Kokoro voice (af_* = female, am_* = male)
DATA_DIR=./data
